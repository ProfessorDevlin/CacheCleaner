<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 is built into Windows 10/11: the .exe runs without an extra runtime -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <AssemblyName>Cache Cleaner</AssemblyName>
    <RootNamespace>CacheCleaner</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Product>Cache Cleaner for RedM &amp; FiveM</Product>
    <AssemblyTitle>Cache Cleaner for RedM &amp; FiveM</AssemblyTitle>
    <Authors>ProfessorDevlin</Authors>
    <Company>ProfessorDevlin</Company>
    <Copyright>© 2026 ProfessorDevlin</Copyright>
    <Version>1.0.0</Version>
    <!-- Show "1.0.0" instead of "1.0.0+<commit hash>" in the file properties -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- No debug symbols in the release build: otherwise the .exe contains the local build path (and the user name) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
